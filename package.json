{
  "name": "gitpulse",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "dist:mac": "next build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.gitpulse.app",
    "productName": "GitPulse",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "files": [
      ".next/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
